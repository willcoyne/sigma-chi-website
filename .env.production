# Production build values. These are NOT secrets: Vite inlines every VITE_*
# variable into the public client bundle, so anyone viewing the site can read
# them. Keep real secrets out of this file and out of any VITE_* name.

# Formspree endpoint for the contact form (src/components/ContactForm.tsx).
# The form posts here from the visitor's browser, so this URL is public by
# design. If this is ever empty, the form silently discards submissions.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mjyvdnkv
