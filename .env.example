# Copy this file to .env.local (or .env) and fill in real values as needed.
# All variables are optional - the site works fully without any of them,
# falling back to local-only/no-op behavior when a variable is unset.
# See package.json/vite.config.ts: this is a standard Vite project, so any
# variable read via `import.meta.env` must be prefixed with VITE_ to be
# exposed to client-side code.

# Formspree endpoint used by the contact form (src/components/ContactForm.tsx)
# to actually deliver submissions by email. Without this set, the form still
# validates input and shows a success message, but nothing is sent anywhere.
# Get a value: sign up for a free account at https://formspree.io, create a
# form, and use its endpoint URL, e.g. https://formspree.io/f/xxxxxxx
VITE_FORMSPREE_ENDPOINT=

# Plausible Analytics site domain used by src/lib/analytics.ts to load the
# Plausible tracking script (see src/main.tsx). Without this set, no
# analytics script is loaded and no third-party request is ever made.
# Get a value: sign up for a free account at https://plausible.io and add
# this site; use the exact domain you register there (e.g. sigmachiwashu.org).
VITE_PLAUSIBLE_DOMAIN=

# Live Instagram feed embed URL used by src/components/InstagramEmbed.tsx
# (shown on the Colony page). Without this set, the component falls back to
# a static "Follow on Instagram" link and bio quote instead of a live feed.
# Get a value: sign up @sigmachiwashu with a free embed service such as
# https://behold.so or https://snapwidget.com and copy the embeddable feed
# URL they generate for you.
VITE_INSTAGRAM_EMBED_URL=
